{
  "name": "burnlint",
  "version": "0.1.0",
  "description": "Cost per run for AI agents: compare before and after a change, and find the avoidable part. Reads Claude Code logs and OpenTelemetry GenAI traces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperbey/burnlint.git"
  },
  "homepage": "https://github.com/alperbey/burnlint#readme",
  "bugs": {
    "url": "https://github.com/alperbey/burnlint/issues"
  },
  "type": "module",
  "bin": {
    "burnlint": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "update-prices": "node scripts/update-prices.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm",
    "agents",
    "opentelemetry",
    "gen_ai",
    "claude-code",
    "token",
    "cost",
    "lint"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  }
}
