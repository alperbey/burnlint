{
  "name": "burnlint",
  "version": "0.4.0",
  "description": "Catch agent cost regressions before they ship: before/after cost per run with a significance test, cost per successful run, and the avoidable spend. Reads Claude Code logs and OpenTelemetry traces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperbey/burnlint.git"
  },
  "homepage": "https://github.com/alperbey/burnlint#readme",
  "bugs": {
    "url": "https://github.com/alperbey/burnlint/issues"
  },
  "type": "module",
  "bin": {
    "burnlint": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "update-prices": "node scripts/update-prices.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm",
    "ai-agents",
    "agents",
    "llm-cost",
    "agent-cost",
    "token-cost",
    "cost-regression",
    "token-usage",
    "llmops",
    "finops",
    "cost",
    "opentelemetry",
    "gen_ai",
    "openinference",
    "openai-agents",
    "vercel-ai-sdk",
    "claude-code",
    "prompt-caching",
    "ci",
    "cli",
    "lint"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  }
}
